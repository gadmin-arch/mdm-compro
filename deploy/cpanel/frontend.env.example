# ── Frontend Next.js — environment untuk cPanel (Setup Node.js App) ──────────
# Nilai-nilai ini dimasukkan lewat panel "Setup Node.js App" → Environment
# Variables (BUKAN sebagai file .env). Nama var di kolom kiri, nilai di kanan.
#
# PENTING soal kapan variabel dibaca:
#   • NEXT_PUBLIC_*  → "dibakar" saat `npm run build`. Kalau diubah, WAJIB build
#     ulang. Ini yang dipakai browser, jadi harus same-origin (path relatif).
#   • Selain NEXT_PUBLIC_* → dibaca saat runtime (server-side), boleh diubah
#     tanpa build ulang, cukup Restart app.

# Server-side: Next memanggil backend Go di localhost. Backend tidak diekspos
# ke internet — Next yang mem-proxy lewat rewrite bawaannya.
CMS_API_BASE_URL=http://127.0.0.1:8080/api/v1/public

# Browser-side: pakai path relatif (same-origin). Panggilan /api/v1/public/*
# dari browser akan di-proxy Next ke backend Go. Jangan pakai http://localhost.
NEXT_PUBLIC_CMS_API_BASE_URL=/api/v1/public

# URL publik subdomain v2.
NEXT_PUBLIC_SITE_URL=https://v2.multidayamitra.co.id
AUTH_URL=https://v2.multidayamitra.co.id
NEXTAUTH_URL=https://v2.multidayamitra.co.id

# Cookie admin dikirim hanya lewat HTTPS (subdomain v2 pakai SSL/AutoSSL).
CMS_COOKIE_SECURE=true

NODE_ENV=production
