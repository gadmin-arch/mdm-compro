# ── Backend Go (mdm-api) — environment untuk cPanel ──────────────────────────
# Salin isi ini ke sebuah file `.env` DI SEBELAH binary mdm-api, lalu isi nilai
# yang ditandai <ISI ...>. File ini dibaca oleh skrip start-api.sh.

APP_ENV=production
HTTP_ADDR=127.0.0.1:8080

# Hanya subdomain v2 yang boleh memanggil API (untuk CORS).
FRONTEND_ORIGINS=https://v2.multidayamitra.co.id

# Koneksi PostgreSQL cPanel. Nama user & database cPanel biasanya berprefix,
# mis. "cpaneluser_mdm". sslmode=disable karena koneksi lokal ke localhost.
DATABASE_URL=postgres://<ISI_DB_USER>:<ISI_DB_PASSWORD>@127.0.0.1:5432/<ISI_DB_NAME>?sslmode=disable

# WAJIB diganti. Buat dengan: openssl rand -base64 48
JWT_SECRET=<ISI_RANDOM_MIN_32_KARAKTER>

ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=2160h
PUBLIC_CACHE_SECONDS=300

# Simpan media di folder biasa (tidak ada MinIO/S3 di cPanel).
STORAGE_DRIVER=local
MEDIA_DIR=/home/<ISI_CPANEL_USER>/mdm-api/data/media

SITE_URL=https://v2.multidayamitra.co.id
CONTACT_NOTIFY_TO=info@multidayamitra.co.id

# SMTP untuk email undangan admin & reset password. Pakai akun email cPanel.
# Kosongkan semua SMTP_* jika belum perlu kirim email (fitur tetap jalan,
# hanya pengiriman email yang tidak aktif).
EMAIL_FROM=MDM CMS <no-reply@multidayamitra.co.id>
SMTP_HOST=mail.multidayamitra.co.id
SMTP_PORT=587
SMTP_USER=no-reply@multidayamitra.co.id
SMTP_PASSWORD=<ISI_PASSWORD_EMAIL>
