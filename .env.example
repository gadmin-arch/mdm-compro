APP_ENV=development
HTTP_ADDR=:8080
FRONTEND_ORIGIN=http://localhost:3010
DATABASE_URL=postgres://mdm:mdm@localhost:5432/mdm_compro?sslmode=disable
# Production refuses to start unless this is a random string of 32+ characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PUBLIC_CACHE_SECONDS=300
CMS_API_BASE_URL=http://localhost:8080/api/v1/public
NEXT_PUBLIC_CMS_API_BASE_URL=http://localhost:8080/api/v1/public
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Media storage: "s3" (MinIO/S3/R2) or "local" (plain directory — use this on
# shared hosting like cPanel where object storage is unavailable).
STORAGE_DRIVER=s3
MEDIA_DIR=./data/media
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mdm-media
S3_USE_SSL=false

# SMTP for invitation and password-reset emails. Keep real values in an
# untracked .env only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MDM CMS <no-reply@multidayamitra.co.id>
